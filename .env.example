# Geometry of Meaning — Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored — never commit secrets.

# --- LLM API keys (for variant generation via prompts/compress.md et al.) ---
# Uncomment and set the providers you use.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# HUGGINGFACE_TOKEN=hf_...

# --- Model cache directory ---
# Where sentence-transformers / torch models are downloaded.
# Defaults to ~/.cache/huggingface if not set.
# MODEL_CACHE_DIR=/path/to/custom/cache

# --- Experiment defaults ---
# Override the random seed for reproducibility experiments.
# GEOMETRY_OF_MEANING_SEED=42

# --- Logging ---
# Set to DEBUG for verbose output, INFO for normal, WARNING for quiet.
# LOG_LEVEL=INFO